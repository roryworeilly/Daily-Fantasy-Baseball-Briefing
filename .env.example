# ESPN Fantasy Baseball credentials — copy this file to .env and fill in your values.
# Grab fresh SWID and ESPN_S2 from:
#   browser DevTools -> Application -> Cookies -> fantasy.espn.com
# whenever you get a 401 / authentication error.

LEAGUE_ID=your_league_id_here
YEAR=2026
MY_TEAM_NAME=Your Team Name Here
N_TEAMS=14

ESPN_SWID={YOUR-SWID-HERE}
ESPN_S2=your_espn_s2_cookie_value_here
